{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "conf-common",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "conf-windows",
      "description": "Visual Studio 2026, needs CMake 4.2 or later",
      "hidden": true,
      "inherits": "conf-common",
      "generator": "Visual Studio 18 2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "conf-linux",
      "hidden": true,
      "inherits": "conf-common",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (original engine)",
      "inherits": "conf-windows",
      "architecture": { "value": "Win32", "strategy": "set" },
      "toolset": { "value": "host=x86", "strategy": "set" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (64-bit OpenJK only)",
      "inherits": "conf-windows",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x64", "strategy": "set" }
    },
    {
      "name": "linux-x86-release",
      "displayName": "Linux x86 Release (original engine)",
      "inherits": "conf-linux",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-x86-debug",
      "displayName": "Linux x86 Debug",
      "inherits": "conf-linux",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release (64-bit OpenJK only)",
      "inherits": "conf-linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "conf-linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x86-release", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "windows-x86-debug", "configurePreset": "windows-x86", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "linux-x86-release", "configurePreset": "linux-x86-release" },
    { "name": "linux-x86-debug", "configurePreset": "linux-x86-debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug" }
  ]
}
